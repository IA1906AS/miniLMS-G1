# Secret key for JWT signing (minimum 32 characters required)
JWT_SECRET=super_secret_jwt_key_that_is_at_least_32_characters_long

# JWT token lifetime in seconds (default: 900)
TOKEN_TTL_SECONDS=900

# Path to the append-only JSON audit log file
AUDIT_LOG_PATH=audit.log

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lms_db
