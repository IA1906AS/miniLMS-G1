# Required: generate a unique random value of at least 32 characters.
# Never reuse this placeholder in a real environment.
JWT_SECRET=

# JWT token lifetime in seconds (default: 900)
TOKEN_TTL_SECONDS=900

# Path to the append-only JSON audit log file
AUDIT_LOG_PATH=audit.log

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lms_db
